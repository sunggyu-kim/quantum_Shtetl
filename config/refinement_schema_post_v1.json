{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scott Aaronson Idea Atlas Post Refinement Output v1",
  "type": "object",
  "required": [
    "post_id",
    "summary_short",
    "summary_long",
    "evidence_quotes",
    "key_claims"
  ],
  "properties": {
    "post_id": { "type": "integer" },
    "summary_short": {
      "type": "string",
      "description": "2-3 sentence synopsis, faithful and website-ready"
    },
    "summary_long": {
      "type": "string",
      "description": "1 dense paragraph capturing argument, context, and notable nuance"
    },
    "evidence_quotes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "key_claims": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "confidence",
          "evidence_quotes",
          "stance_target",
          "stance_polarity"
        ],
        "properties": {
          "claim": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_quotes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "type": "string" }
          },
          "stance_target": { "type": ["string", "null"] },
          "stance_polarity": {
            "type": ["string", "null"],
            "enum": ["support", "oppose", "skeptical", "conditional", null]
          },
          "why_it_matters": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "stance_summary": {
      "type": ["object", "null"],
      "properties": {
        "target": { "type": ["string", "null"] },
        "polarity": {
          "type": ["string", "null"],
          "enum": ["support", "oppose", "skeptical", "conditional", null]
        },
        "rationale": { "type": "string" }
      },
      "additionalProperties": true
    },
    "editor_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prompt_version": { "type": "string" },
    "schema_version": { "type": "string" }
  },
  "additionalProperties": true
}
